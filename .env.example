# Copy this file to .env and fill in values
# Mandatory
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Directories
DOWNLOADS_DIR=downloads
QUEUE_STATE_FILE=downloads/queue_state.json

# Limits
MAX_SONG_DURATION=600
MAX_QUEUE_SIZE=50
AUDIO_BITRATE=320
THROTTLED_RATE=
YTDLP_CONCURRENT_FRAGMENTS=4
YTDLP_HTTP_CHUNK_SIZE=1048576
YTDLP_SOCKET_TIMEOUT=30
YTDLP_FORCE_IPV4=true

# Workers & Rate Limiting
CONCURRENT_WORKERS=2
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600

# Metrics
METRICS_PORT=8000

# Logging
LOG_LEVEL=INFO

# Optional explicit ffmpeg location (directory containing ffmpeg & ffprobe)
# FFMPEG_LOCATION=/path/to/ffmpeg_dir

# JavaScript runtime for yt-dlp (Deno)
ENABLE_JS_RUNTIME=true
# DENO_PATH=./deno.exe

# Subscription polling
SUBSCRIPTION_POLL_INTERVAL=600
SUBSCRIPTIONS_FILE=downloads/subscriptions.json

# Video constraints
MAX_VIDEO_SIZE_MB=50
TRANSCODE_TARGET_SIZE_MB=48
